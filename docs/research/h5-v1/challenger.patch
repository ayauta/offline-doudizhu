+export type CandidateRollout = Readonly<{
+  /** The expert ranking's score, before any rollout blend. */
+  expertScore: number;
+  /** Σ utilities over the completed worlds — the terminal trajectories included. */
+  total: number;
+  /** Σ utilities over just the terminal trajectories among them. */
+  terminalTotal: number;
+  /** The winner of each terminal trajectory, in the order the worlds were sampled. */
+  terminalWinners: readonly (Seat | null)[];
