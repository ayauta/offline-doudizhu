+export type TerminalVerdict = "none" | "win" | "loss" | "conflicting";
+
+/**
+ * Which way one candidate's terminal trajectories point, read from the **root
+ * seat's side**. 斗地主 has two sides, and the seat acting inside a rollout is
+ * not the seat whose decision this is: resolving every winner against
+ * `rootSeat`/`landlord` is the only formulation that cannot invert the sign at
+ * a farmer seat. A `null` winner is a trajectory that cannot be attributed to
+ * either side, which the freeze also treats as no evidence.
+ *
+ * `"win"`/`"loss"` are the only verdicts that open the gate. `"none"` (no
+ * trajectory reached a decided position) and `"conflicting"` (sampled worlds
+ * disagree) both mean "the rollout did not settle the question".
+ */
+export function terminalVerdict(
+  rootSeat: Seat,
+  landlord: Seat,
+  terminalWinners: readonly (Seat | null)[],
+): TerminalVerdict {
+  const first = terminalWinners[0];
+  if (first === undefined) {
+    return "none";
+  }
+  if (first === null) {
+    return "conflicting";
+  }
+  const rootWon = isSameSide(rootSeat, first, landlord);
+  for (const winner of terminalWinners) {
+    if (winner === null || isSameSide(rootSeat, winner, landlord) !== rootWon) {
+      return "conflicting";
+    }
+  }
+  return rootWon ? "win" : "loss";
+}
