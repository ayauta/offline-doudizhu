diff --git a/tests/core/hand-planning.test.ts b/tests/core/hand-planning.test.ts
new file mode 100644
index 0000000..3a43244
--- /dev/null
+++ b/tests/core/hand-planning.test.ts
@@ -0,0 +1,75 @@
+import { describe, expect, it } from "vitest";
+
+import { createHandAnalyzer } from "../../src/core/ai/enhanced.js";
+import { asCardId, type CardId } from "../../src/core/cards/index.js";
+import { generateLegalActions } from "../../src/core/rules/index.js";
+
+function handWithCounts(counts: readonly number[]): CardId[] {
+  return counts.flatMap((count, rank) =>
+    Array.from({ length: count }, (_, suit) => asCardId(rank * 4 + suit)));
+}
+
+// Independent exhaustive legal partitions: no production estimates or pruning.
+function exactPartitionOracle(): (hand: readonly CardId[]) => number {
+  const cache = new Map<string, number>();
+  function solve(hand: readonly CardId[]): number {
+    if (hand.length === 0) return 0;
+    const key = [...hand].sort((a, b) => a - b).join(",");
+    const cached = cache.get(key);
+    if (cached !== undefined) return cached;
+    let best = hand.length;
+    for (const action of generateLegalActions({ hand, currentPlay: null })) {
+      if (action.type !== "play") continue;
+      const played = new Set(action.play.cards);
+      best = Math.min(best, 1 + solve(hand.filter(card => !played.has(card))));
+      if (best === 1) break;
+    }
+    cache.set(key, best);
+    return best;
+  }
+  return solve;
+}
+
+describe("bounded enhanced hand planning", () => {
+  it.each([
+    { label: "3334445", counts: [3, 3, 1], turns: 2 },
+    { label: "3334455", counts: [3, 2, 2], turns: 2 },
+    { label: "33344556", counts: [3, 2, 2, 1], turns: 3 },
+  ])("does not invent overlapping savings for $label", ({ counts, turns }) => {
+    const hand = handWithCounts(counts);
+    expect(exactPartitionOracle()(hand)).toBe(turns);
+    expect(createHandAnalyzer({ maxNodes: 10_000 }).analyze(hand).minimumTurns).toBe(turns);
+  });
+
+  it("never underestimates exhaustive small-hand partitions, even on tiny budgets", () => {
+    const exact = exactPartitionOracle();
+    for (let encoding = 0; encoding < 256; encoding += 1) {
+      const counts = Array.from({ length: 4 }, (_, rank) =>
+        Math.floor(encoding / (4 ** rank)) % 4);
+      const hand = handWithCounts(counts);
+      if (hand.length > 9) continue;
+      const optimum = exact(hand);
+      for (const maxNodes of [1, 2, 16]) {
+        const analyzer = createHandAnalyzer({ maxNodes });
+        const snapshot = [...hand];
+        const estimate = analyzer.analyze(hand);
+        expect(estimate.minimumTurns, `${counts} / ${maxNodes} nodes`).toBeGreaterThanOrEqual(optimum);
+        expect(estimate.minimumTurns).toBeLessThanOrEqual(counts.filter(count => count > 0).length);
+        expect(analyzer.stats().visitedNodes).toBeLessThanOrEqual(maxNodes);
+        expect(analyzer.analyze([...hand].reverse())).toBe(estimate);
+        expect(hand).toEqual(snapshot);
+      }
+      expect(createHandAnalyzer({ maxNodes: 10_000 }).analyze(hand).minimumTurns).toBe(optimum);
+    }
+  });
+
+  it("keeps a feasible estimate after another hand exhausts the shared budget", () => {
+    const analyzer = createHandAnalyzer({ maxNodes: 1 });
+    analyzer.analyze(handWithCounts([1]));
+    expect(analyzer.stats().visitedNodes).toBe(1);
+    const hand = handWithCounts([3, 2, 2, 1]);
+    expect(analyzer.analyze(hand).minimumTurns).toBeGreaterThanOrEqual(3);
+    expect(analyzer.stats().visitedNodes).toBe(1);
+    expect(analyzer.analyze([]).minimumTurns).toBe(0);
+  });
+});
