{
  "name": "offline-doudizhu",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, accessible Dou Dizhu Web/PWA and Android game",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bench:ai": "vitest run --config vitest.benchmark.config.ts --reporter=verbose",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check:android": "node scripts/check-android.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
